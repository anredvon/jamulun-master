[Unit]
Description=Jaemulun Flask web app (isolated from ScienceLoop)
After=network.target

[Service]
Type=simple
User=jaemulun
Group=jaemulun
WorkingDirectory=/srv/jaemulun/current
EnvironmentFile=/etc/jaemulun.env
ExecStart=/srv/jaemulun/current/.venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8002 --timeout 30 app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/jaemulun/shared

[Install]
WantedBy=multi-user.target
